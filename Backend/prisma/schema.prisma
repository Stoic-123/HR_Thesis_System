model laterequest {
  id                        Int                 @id @default(autoincrement())
  company_id                Int
  employee_id               Int
  request_type              String              @default("LATE") @db.VarChar(20) // LATE or EARLY
  time_field                String?             @db.VarChar(20) // time_in, lunch_in, lunch_out, time_out
  scheduled_time            String?             @db.VarChar(10) // e.g. 08:00, 12:00, 13:00, 17:00
