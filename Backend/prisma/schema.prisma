  @@index([company_id], map: "idx_payroll_company")
  @@index([company_id, status], map: "idx_payroll_company_status")
  @@index([payroll_period_id, employee_id], map: "idx_payroll_period_emp")
  @@index([employee_id], map: "idx_payroll_employee")
  @@index([payroll_period_id], map: "idx_payroll_period")
  payrolladjustment payrolladjustment[]

  @@unique([payroll_period_id, employee_id], map: "unique_payroll_period_employee")
  @@index([company_id, payroll_period_id], map: "idx_payroll_company_period")
  @@index([status], map: "idx_payroll_status")
}

model payrollitem {
