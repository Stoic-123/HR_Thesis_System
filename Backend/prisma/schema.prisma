model payroll {
  id                Int             @id @default(autoincrement())
  company_id        Int
  payroll_period_id Int
  employee_id       Int
  base_salary       Decimal         @default(0) @db.Decimal(12, 2)
  allowance         Decimal         @default(0) @db.Decimal(12, 2)
  overtime          Decimal         @default(0) @db.Decimal(12, 2)
  bonus             Decimal         @default(0) @db.Decimal(12, 2)
  deduction         Decimal         @default(0) @db.Decimal(12, 2)
  tax               Decimal         @default(0) @db.Decimal(12, 2)
  gross_salary      Decimal         @default(0) @db.Decimal(12, 2)
  net_salary        Decimal         @default(0) @db.Decimal(12, 2)
  status            payroll_status  @default(draft)
  payslip_path      String?         @db.VarChar(500)
  created_at        DateTime?       @default(now()) @db.DateTime(0)
  updated_at        DateTime?       @default(now()) @db.DateTime(0)
  company           company         @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "payroll_ibfk_1")
  payrollperiod     payrollperiod   @relation(fields: [payroll_period_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "payroll_ibfk_2")
