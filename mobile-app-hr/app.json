{
  "expo": {
    "name": "Votmean",
    "slug": "Votmean",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.muyheang.Votmean",
      "buildNumber": "30",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Allow Votmean to access your camera for attendance selfie verification.",
        "NSLocationWhenInUseUsageDescription": "Allow Votmean to access your location to verify attendance check-in.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow Votmean to access your location to verify attendance check-in.",
        "NSPhotoLibraryUsageDescription": "Allow Votmean to access your photos for profile pictures and leave request attachments."
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera for attendance selfie."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to access your location to verify attendance."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to attach documents."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos."
        }
      ],
      "expo-font"
    ],
    "android": {
      "backgroundColor": "#0F172A",
      "package": "com.muyheang.Votmean",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "apiUrl": "https://api.bayonhr.shop",
      "eas": {
        "projectId": "38bd42f8-c82c-4792-9db8-a9145e91c4ca"
      }
    },
    "owner": "stoic_0110"
  }
}
