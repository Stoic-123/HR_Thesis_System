# ── Dependencies (reinstalled during build) ───────────────────────────────────
node_modules

# ── Next.js build output (rebuilt during docker build) ────────────────────────
.next

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.*
!.env.example
.env.local
.env.*.local

# ── Dev / debug artefacts ─────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── TypeScript incremental build cache ────────────────────────────────────────
tsconfig.tsbuildinfo

# ── Misc dev tooling ──────────────────────────────────────────────────────────
.git
.gitignore
.vscode
AGENTS.md
CLAUDE.md
README.md

# ── Package manager lock files (npm install runs fresh) ───────────────────────
bun.lock
